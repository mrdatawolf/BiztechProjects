# ── Web Server ────────────────────────────────────────────────────────────────
# Address the server binds to.  0.0.0.0 means all network interfaces (accessible
# from other machines on the network).  Use 127.0.0.1 to restrict to localhost only.
HOST=0.0.0.0

# Port the web server listens on.
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the PGLite database directory.
# Can be an absolute path (e.g. /opt/projectplan/data/db) or a path relative
# to the app/ folder (e.g. ./data/projectdb stores data at app/data/projectdb).
# Use memory:// for a throw-away in-memory database (data lost on restart).
DB_PATH=Data/projectdb

# ── Authentication ────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens.  KEEP THIS PRIVATE — anyone who knows it
# can forge login tokens.  Generate a fresh value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# How long a login session stays valid (e.g. 7d, 24h, 60m).
JWT_EXPIRES_IN=7d
